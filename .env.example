# ============================================================
# SHALO COM SPACE - BATIANA TECH
# Fichier d'exemple. Copier en `.env.local` (ou `.env`) et renseigner.
# Ne jamais versionner un fichier contenant de vrais secrets.
# ============================================================

# ------------------------------------------------------------
# OBLIGATOIRE
# ------------------------------------------------------------
# Cle maitresse utilisee pour chiffrer les secrets stockes en base
# (jetons reseaux sociaux, cles IA saisies par les entreprises).
# Minimum 16 caracteres. Generer une valeur aleatoire longue.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENTION : changer cette valeur rend illisible tout secret deja chiffre.
APP_SECRET=changez_cette_cle_aleatoire_de_32_caracteres_minimum

# Chemin du fichier SQLite (relatif au dossier du projet ou absolu).
# Par defaut : ./data/shalo.db
DATABASE_PATH=./data/shalo.db

# URL publique de l'instance (liens absolus, apercus reseaux sociaux).
# En production : https://app.exemple.com
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# FOURNISSEURS IA (facultatif)
# Une cle d'entreprise saisie dans Reglages > IA est prioritaire.
# A defaut, la cle d'environnement ci-dessous est utilisee.
# Sans aucune cle, le Centre IA refuse de generer (aucune simulation).
# ------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
SHALORAH_API_KEY=

# ------------------------------------------------------------
# RESEAUX SOCIAUX (facultatif)
# La publication automatique n'est proposee que si TOUTES les
# variables de la plateforme sont renseignees. Sinon, la procedure
# manuelle (publier puis declarer) reste la seule option.
# ------------------------------------------------------------
# Facebook (Page)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram (compte professionnel, relies a l'app Meta)
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# LinkedIn (Page entreprise)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube (Data API v3)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
